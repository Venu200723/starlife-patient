# STAR LIFE CLINIC — patient site (Vercel project 1). Paste into
# Vercel → Settings → Environment Variables (Production + Preview).

# Supabase Postgres — pooler URL (Vercel/serverless friendly).
# Supabase Dashboard → Connect → "Connection pooler" URI, add ?pgbouncer=true
DATABASE_URL=
# Same dashboard, "Direct connection" URI (port 5432) — used by prisma db push.
DIRECT_URL=

# Session signing (already known — see DEPLOY.md values table)
AUTH_SECRET=
# Staff portal credentials — OPTIONAL, seed-script only. Real staff login
# validates against the `admins` table synced in Step 1 (see DEPLOY.md).
ADMIN_USERNAME=admin1
ADMIN_PASSWORD=

# Supabase Auth (same values as the sandbox .env)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=

# The public URL of THIS deployment, e.g. https://starlife-clinic.vercel.app
# (set it AFTER the first deploy reveals the URL, then redeploy)
APP_ORIGIN=
# Optional: URL of the ADMIN deployment so <patient>/staff works, e.g.
# https://starlife-admin.vercel.app  (admin link on the patient domain)
STAFF_ORIGIN=
